# Anthropic — get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Finnhub — get a free key at https://finnhub.io/register
FINNHUB_API_KEY=

# Set to "true" to serve canned data for AAPL/MSFT/NVDA/TSLA/GOOGL
# when no API keys are configured. The app auto-falls-back to demo
# mode if ANTHROPIC_API_KEY is missing.
DEMO_MODE=false
