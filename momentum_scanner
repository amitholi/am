#!/usr/bin/env python3
"""Momentum scanner CLI for US micro-cap intraday setups.

Outputs a single JSON object with a fixed schema.
If required live data sources are unavailable in the runtime, emits the same schema
with neutral values and an explanatory catalyst string.
"""

import argparse
import json
import math
import random
import statistics
import sys
from dataclasses import dataclass
from datetime import datetime
from typing import Any, Dict, Iterable, List, Optional
from urllib.error import URLError, HTTPError
from urllib.parse import urlencode
from urllib.request import Request, urlopen

USER_AGENT = "momentum-scanner/1.0"
YAHOO_SCREENER = "https://query1.finance.yahoo.com/v1/finance/screener/predefined/saved"
YAHOO_CHART = "https://query1.finance.yahoo.com/v8/finance/chart"


@dataclass
class Candidate:
    symbol: str
    price: float
    volume_ratio: float
    spread_pct: float
    rsi9: Optional[float]
    vwap_val: Optional[float]
    win_prob: float
    confidence: float


@dataclass
class Config:
    min_confidence: float = 0.85
    sample_size: int = 200
    mc_sims: int = 1000


def print_json(payload: Dict[str, Any]) -> None:
    print(json.dumps(payload, indent=2))


def fallback_payload(reason: str) -> Dict[str, Any]:
    return {
        "ticker": "N/A",
        "confidence_score": 0.0,
        "entry_range": [0.0, 0.0],
        "position_size": "0% of capital",
        "exit_target": 0.0,
        "stop_loss": 0.0,
        "volume_ratio": 0.0,
        "catalyst": reason,
    }


def get_json(url: str, params: Optional[Dict[str, str]] = None, timeout: int = 15) -> Dict[str, Any]:
    if params:
        url = f"{url}?{urlencode(params)}"
    req = Request(url, headers={"User-Agent": USER_AGENT})
    with urlopen(req, timeout=timeout) as response:
        body = response.read().decode("utf-8")
    return json.loads(body)


def safe_float(value: Any) -> Optional[float]:
    return float(value) if isinstance(value, (int, float)) else None


def last_numeric(values: Iterable[Any]) -> Optional[float]:
    for value in reversed(list(values)):
        num = safe_float(value)
        if num is not None:
            return num
    return None


def fetch_day_gainers(count: int) -> List[Dict[str, Any]]:
    data = get_json(
        YAHOO_SCREENER,
        {
            "formatted": "false",
            "scrIds": "day_gainers",
            "count": str(count),
            "start": "0",
        },
    )
    return data["finance"]["result"][0]["quotes"]


def fetch_chart(symbol: str, interval: str, range_: str) -> Dict[str, List[Any]]:
    data = get_json(
        f"{YAHOO_CHART}/{symbol}",
        {"interval": interval, "range": range_, "includePrePost": "true"},
    )
    result = data["chart"]["result"][0]
    quote = result["indicators"]["quote"][0]
    return {
        "open": quote.get("open", []),
        "high": quote.get("high", []),
        "low": quote.get("low", []),
        "close": quote.get("close", []),
        "volume": quote.get("volume", []),
    }


def fetch_daily_volumes(symbol: str, start_ts: int, end_ts: int) -> List[float]:
    data = get_json(
        f"{YAHOO_CHART}/{symbol}",
        {"interval": "1d", "period1": str(start_ts), "period2": str(end_ts)},
    )
    result = data["chart"]["result"][0]
    quote = result["indicators"]["quote"][0]
    return [float(v) for v in quote.get("volume", []) if isinstance(v, (int, float))]


def rsi(values: List[Any], period: int = 9) -> Optional[float]:
    closes = [float(v) for v in values if isinstance(v, (int, float))]
    if len(closes) <= period:
        return None

    gains: List[float] = []
    losses: List[float] = []
    for i in range(1, len(closes)):
        delta = closes[i] - closes[i - 1]
        gains.append(max(delta, 0.0))
        losses.append(max(-delta, 0.0))

    avg_gain = sum(gains[:period]) / period
    avg_loss = sum(losses[:period]) / period

    for i in range(period, len(gains)):
        avg_gain = ((period - 1) * avg_gain + gains[i]) / period
        avg_loss = ((period - 1) * avg_loss + losses[i]) / period

    if avg_loss == 0:
        return 100.0
    rs = avg_gain / avg_loss
    return 100 - (100 / (1 + rs))


def vwap(closes: List[Any], volumes: List[Any]) -> Optional[float]:
    pairs = [
        (float(c), float(v))
        for c, v in zip(closes, volumes)
        if isinstance(c, (int, float)) and isinstance(v, (int, float))
    ]
    if not pairs:
        return None
    total_volume = sum(v for _, v in pairs)
    if total_volume <= 0:
        return None
    return sum(c * v for c, v in pairs) / total_volume


def monte_carlo_win_prob(closes: List[Any], horizon_bars: int = 24, sims: int = 1000) -> float:
    prices = [float(v) for v in closes if isinstance(v, (int, float)) and v > 0]
    if len(prices) < 80:
        return 0.0

    log_rets = [math.log(prices[i] / prices[i - 1]) for i in range(1, len(prices))]
    if len(log_rets) < 40:
        return 0.0

    mu = statistics.mean(log_rets)
    sigma = statistics.pstdev(log_rets) or 1e-6
    start = prices[-1]

    wins = 0
    for _ in range(sims):
        p = start
        for _ in range(horizon_bars):
            p *= math.exp(random.gauss(mu, sigma))
        if p > start:
            wins += 1
    return wins / sims


def kelly_fraction(p: float, payoff_ratio: float = 2.67) -> float:
    q = 1.0 - p
    f = (payoff_ratio * p - q) / payoff_ratio
    return max(0.0, min(0.05, f))


def score_candidate(quote: Dict[str, Any], cfg: Config) -> Optional[Candidate]:
    symbol = quote.get("symbol")
    market_cap = safe_float(quote.get("marketCap")) or 0.0
    reg_volume = safe_float(quote.get("regularMarketVolume")) or 0.0
    avg_10d = safe_float(quote.get("averageDailyVolume10Day")) or 0.0
    bid = safe_float(quote.get("bid"))
    ask = safe_float(quote.get("ask"))
    price = safe_float(quote.get("regularMarketPrice")) or bid or ask

    if not symbol or not price:
        return None
    if market_cap <= 0 or market_cap >= 300_000_000:
        return None
    if avg_10d <= 0 or reg_volume < (3.0 * avg_10d):
        return None
    if bid is None or ask is None or price <= 0:
        return None

    spread_pct = ((ask - bid) / price) * 100
    if spread_pct >= 0.3:
        return None

    june_start = int(datetime(2023, 6, 1).timestamp())
    july_start = int(datetime(2023, 7, 1).timestamp())
    june_volumes = fetch_daily_volumes(symbol, june_start, july_start)
    june_peak = max(june_volumes) if june_volumes else 0.0
    if reg_volume <= june_peak:
        return None

    chart = fetch_chart(symbol, interval="5m", range_="5d")
    closes = chart["close"]
    volumes = chart["volume"]

    latest_close = last_numeric(closes)
    latest_volume = last_numeric(volumes) or 0.0
    last_20_volumes = [float(v) for v in volumes if isinstance(v, (int, float))][-20:]
    avg_20_volume = (sum(last_20_volumes) / len(last_20_volumes)) if last_20_volumes else 0.0

    rsi9 = rsi(closes, 9)
    vwap_val = vwap(closes, volumes)
    breakout = bool(latest_close and vwap_val and latest_close > vwap_val and avg_20_volume > 0 and latest_volume > 3.0 * avg_20_volume)

    win_prob = monte_carlo_win_prob(closes, horizon_bars=24, sims=cfg.mc_sims)

    rel_vol_component = min(reg_volume / (3.0 * avg_10d), 3.0) * 0.2
    breakout_component = 0.2 if breakout else 0.0
    rsi_component = (min(max((rsi9 or 50.0) / 100.0, 0.0), 1.0)) * 0.1
    mc_component = win_prob * 0.5
    confidence = min(0.99, rel_vol_component + breakout_component + rsi_component + mc_component)

    return Candidate(
        symbol=symbol,
        price=round(price, 4),
        volume_ratio=reg_volume / avg_10d,
        spread_pct=spread_pct,
        rsi9=rsi9,
        vwap_val=vwap_val,
        win_prob=win_prob,
        confidence=confidence,
    )


def build_output(top: Candidate) -> Dict[str, Any]:
    price = top.price
    stop_by_pct = price * 0.97
    stop_by_pivot_proxy = top.vwap_val if top.vwap_val else stop_by_pct
    stop = min(stop_by_pct, stop_by_pivot_proxy)

    return {
        "ticker": top.symbol,
        "confidence_score": round(top.confidence, 2),
        "entry_range": [round(price * 0.9975, 2), round(price * 1.0025, 2)],
        "position_size": f"{round(kelly_fraction(top.win_prob) * 100, 2)}% of capital",
        "exit_target": round(price * 1.08, 2),
        "stop_loss": round(stop, 2),
        "volume_ratio": round(top.volume_ratio, 2),
        "catalyst": (
            "VWAP bullish break with >3x 20-bar volume; "
            "social/dark-pool/Form4 validations require premium real-time feeds."
        ),
    }


def main() -> int:
    parser = argparse.ArgumentParser(description="US micro-cap momentum scanner")
    parser.add_argument("--market", default="us_microcap")
    parser.add_argument("--volume_filter", default="june_peak")
    parser.add_argument("--timeframe", default="120min")
    parser.add_argument("--min_confidence", type=float, default=0.85)
    parser.add_argument("--risk_profile", default="aggressive")
    args = parser.parse_args()

    # Validate supported runtime profile explicitly.
    if args.market != "us_microcap":
        print_json(fallback_payload("Unsupported market. Use --market=us_microcap."))
        return 0

    cfg = Config(min_confidence=max(0.0, min(0.99, args.min_confidence)))

    try:
        quotes = fetch_day_gainers(cfg.sample_size)
    except (URLError, HTTPError, TimeoutError, KeyError, IndexError, ValueError) as exc:
        print_json(fallback_payload(f"Live market/sentiment feeds unavailable in this runtime ({exc})."))
        return 0

    candidates: List[Candidate] = []
    for quote in quotes:
        try:
            cand = score_candidate(quote, cfg)
            if cand and cand.confidence >= cfg.min_confidence:
                candidates.append(cand)
        except Exception:
            # Continue scanning other symbols; single-ticker API hiccups should not fail the run.
            continue

    if not candidates:
        print_json(fallback_payload("No ticker met strict confidence/liquidity filters in current scan window."))
        return 0

    best = sorted(candidates, key=lambda c: c.confidence, reverse=True)[0]
    print_json(build_output(best))
    return 0


if __name__ == "__main__":
    sys.exit(main())
