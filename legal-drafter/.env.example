# Anthropic Claude API — primary LLM
ANTHROPIC_API_KEY=

# Voyage AI — primary embedding provider (better for Hebrew)
VOYAGE_API_KEY=

# OpenAI — fallback embedding provider (text-embedding-3-large)
OPENAI_API_KEY=

# Model overrides (optional)
ANTHROPIC_MODEL=claude-opus-4-7
ANTHROPIC_TEMPERATURE=0.3
VOYAGE_MODEL=voyage-3
OPENAI_EMBED_MODEL=text-embedding-3-large

# Paths (optional — defaults to repo-relative)
STYLE_BANK_DIR=style_bank
OUTPUT_DIR=output
DB_PATH=legal_drafter.db
